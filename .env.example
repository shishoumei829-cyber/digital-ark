# 数字方舟 - 环境变量配置

# 服务器配置
PORT=3000

# Persona / 数字分身
PERSONA_ID=alisa-kujo
# 微调后的 Ollama 模型名（运行 npm run ollama:persona 后填入）
# PERSONA_MODEL=digital-ark-alisa-kujo
# OLLAMA_BASE_MODEL=qwen2.5:7b
# LORA_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Ollama配置
OLLAMA_BASE=http://127.0.0.1:11434
CHAT_MODEL=kurisu:latest
EMBED_MODEL=nomic-embed-text

# GPT-SoVITS TTS（可选）
SOVITS_URL=http://127.0.0.1:9880
SOVITS_REF=

# 数据目录（默认在用户目录下）
# DATA_DIR=C:\Users\YourName\digital_ark_data

# 训练配置
MAX_TRAINING_SESSIONS=100
VOICE_SIMILARITY_THRESHOLD=0.7

# 陪护配置
AUTO_GREETING=true
GREETING_FREQUENCY=medium
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00

# 数据加密（调用 /security/encrypt 时使用口令，不建议明文存此处）
# DATA_ENCRYPTION_KEY=
